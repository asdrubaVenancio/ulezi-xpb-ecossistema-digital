# ============================================================
# ULEZI XPB — Variáveis de Ambiente do Backend
# Copie este ficheiro para .env e preencha os valores
# NUNCA adicione o .env ao Git!
# ============================================================

# Servidor
NODE_ENV=development
PORT=5000

# Base de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=a_sua_password_mysql
DB_NAME=ulezi2_xpb

# JWT — use strings longas e aleatórias (mínimo 32 caracteres)
JWT_SECRET=coloque_aqui_uma_chave_secreta_muito_longa_e_aleatoria
JWT_EXPIRES=24h
JWT_REFRESH_SECRET=outra_chave_secreta_diferente_para_refresh_token
JWT_REFRESH_EXPIRES=7d

# Frontend URL (para configuração CORS)
FRONTEND_URL=http://localhost:3000

# Upload de ficheiros
UPLOAD_DIR=./uploads

# Email (Nodemailer)
# Para Gmail, active "App Passwords" na conta Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=o_seu_email@gmail.com
SMTP_PASS=password_de_aplicacao_gmail
EMAIL_FROM=ULEZI XPB <noreply@ulezi.com>

# WhatsApp (CallMeBot ou similar — opcional)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
